# Environment template for the Personalized Learning RAG Assistant (backend).
#
# Usage:
#   cp .env.example .env   then fill in the real values.
# The app reads these via app/core/config.py (pydantic-settings).
# Variable names are case-insensitive; the lowercase field names also work.
#
# NEVER commit a real .env. Values marked "CHANGE ME" must be set before
# running outside local development.

# --- MongoDB (Atlas) ---
# Local dev default; for Atlas use e.g.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=healthcare_rag

# --- Auth / JWT ---
# CHANGE ME: generate a long random secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins (the Angular dev server by default).
CORS_ORIGINS=http://localhost:4200

# --- Uploads ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20

# --- LLM / Embedding provider ---
# llm_provider: openai | anthropic | bedrock | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# CHANGE ME: provider API key. Leave blank for local/offline providers (e.g. ollama).
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Retrieval / Atlas Vector Search ---
VECTOR_INDEX_NAME=vector_index
VECTOR_SEARCH_CANDIDATES=100
RETRIEVAL_TOP_K=5
